# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
READ_TIMEOUT=60s
WRITE_TIMEOUT=60s

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docvault?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Storage Configuration (NFS)
STORAGE_BASE_PATH=/data/documents
STORAGE_TEMP_PATH=/data/documents/temp
STORAGE_PREVIEW_PATH=/data/documents/preview
STORAGE_ORGANIZE_BY_DATE=true
STORAGE_CHUNK_SIZE=5242880
STORAGE_BUFFER_SIZE=262144
STORAGE_MAX_FILE_SIZE=104857600

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h

# Security Configuration
ENABLE_MAGIC_BYTE_CHECK=true
ENABLE_MIME_CHECK=true
ENABLE_MALWARE_SCANNER=true
ENABLE_DOCUMENT_CHECK=true
ENABLE_ANTIVIRUS_SCAN=false
CLAMAV_ADDRESS=localhost:3310
ENABLE_QUARANTINE=true
QUARANTINE_PATH=/data/quarantine
TEMP_SCAN_PATH=/tmp/security-scan
